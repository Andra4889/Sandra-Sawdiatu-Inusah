
:root {
  --navy: #102A43;
  --teal: #087F8C;
  --teal-dark: #06616B;
  --white: #FFFFFF;
  --background: #F7FAF9;
  --sage: #DCEBE7;
  --text: #243B53;
  --muted: #627D87;
  --border: #DCE6E5;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  font-family: "Segoe UI", Arial, sans-serif;
  color: var(--text);
  background: var(--white);
  line-height: 1.75;
}

a {
  color: var(--teal);
  text-decoration: none;
}

a:hover {
  color: var(--teal-dark);
}

img {
  display: block;
  max-width: 100%;
}

.container {
  width: min(1140px, 90%);
  margin: auto;
}

.section {
  padding: 85px 0;
}

.section-light {
  background: var(--background);
}

h1, h2, h3, h4 {
  color: var(--navy);
  line-height: 1.3;
}

h1 {
  font-size: clamp(2.7rem, 5vw, 4.6rem);
  margin: 12px 0 18px;
}

h2 {
  font-size: clamp(1.9rem, 3vw, 2.6rem);
  margin: 8px 0 25px;
}

h3 {
  font-size: 1.25rem;
}

h4 {
  font-size: 1rem;
  color: var(--muted);
}

.eyebrow {
  color: var(--teal);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.center {
  text-align: center;
  justify-content: center;
}

/* NAVIGATION */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255,255,255,0.97);
  border-bottom: 1px solid var(--border);
}

.nav {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
}

.brand {
  color: var(--navy);
  font-size: 1.25rem;
  font-weight: 800;
  white-space: nowrap;
}

.brand span {
  color: var(--teal);
}

.nav-links {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
}

.nav-links a {
  color: var(--navy);
  font-size: 0.82rem;
  font-weight: 600;
}

.nav-links a:hover {
  color: var(--teal);
}

.menu-toggle {
  display: none;
  background: none;
  border: none;
  font-size: 1.6rem;
  cursor: pointer;
}

/* HERO */
.hero {
  background: linear-gradient(120deg, #102A43, #173D4F);
  padding: 90px 0;
  color: white;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.25fr 0.85fr;
  align-items: center;
  gap: 65px;
}

.hero h1,
.hero h2 {
  color: white;
}

.hero h1 span {
  color: #74D3CF;
}

.hero h2 {
  font-size: 1.55rem;
  font-weight: 500;
}

.hero p {
  color: #E1EAF0;
}

.hero .eyebrow {
  color: #82DBD3;
}

.hero-description {
  font-size: 1.08rem;
  max-width: 650px;
}

.hero-image img {
  width: 100%;
  max-height: 530px;
  object-fit: cover;
  object-position: center top;
  border-radius: 20px;
  box-shadow: 0 20px 55px rgba(0,0,0,0.25);
}

/* BUTTONS */
.button-group {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 30px;
}

.btn {
  display: inline-block;
  padding: 12px 22px;
  border-radius: 7px;
  font-size: 0.93rem;
  font-weight: 700;
  transition: 0.2s;
}

.btn-primary {
  background: var(--teal);
  color: white;
}

.btn-primary:hover {
  background: var(--teal-dark);
  color: white;
}

.btn-outline {
  border: 1px solid var(--teal);
  color: var(--teal);
  background: transparent;
}

.hero .btn-outline {
  color: white;
  border-color: white;
}

.btn-outline:hover {
  background: var(--sage);
  color: var(--navy);
}

/* CARDS */
.card-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 25px;
  margin-top: 30px;
}

.project-card,
.info-card,
.feature-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
  margin-bottom: 20px;
}

.project-card {
  transition: transform 0.2s, box-shadow 0.2s;
}

.project-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 14px 35px rgba(16,42,67,0.10);
}

.project-card img {
  width: 100%;
  height: 230px;
  object-fit: cover;
}

.card-content,
.info-card,
.feature-card {
  padding: 26px;
}

.tag {
  display: inline-block;
  background: var(--sage);
  color: var(--teal-dark);
  font-size: 0.76rem;
  font-weight: 700;
  border-radius: 5px;
  padding: 5px 10px;
}

.project-card a {
  font-weight: 700;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-top: 35px;
}

.stat {
  padding: 23px;
  border: 1px solid var(--border);
  border-radius: 12px;
  text-align: center;
}

.stat strong {
  display: block;
  color: var(--teal);
  font-size: 2rem;
}

.stat span {
  color: var(--muted);
  font-size: 0.85rem;
}

/* EXPERIENCE TIMELINE */
.timeline {
  border-left: 3px solid var(--teal);
  margin-left: 12px;
  padding-left: 30px;
}

.timeline-item {
  position: relative;
  padding: 0 0 28px;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: -39px;
  top: 8px;
  width: 14px;
  height: 14px;
  background: var(--teal);
  border: 3px solid white;
  border-radius: 50%;
}

.date {
  color: var(--teal);
  font-weight: 700;
  font-size: 0.88rem;
}

.timeline-item h3 {
  margin: 8px 0 3px;
}

.timeline-item h4 {
  margin: 0;
}

.publication {
  padding: 20px 0;
  border-bottom: 1px solid var(--border);
}

.link-list li {
  margin: 12px 0;
}

/* PHOTO GALLERY */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
  margin-top: 30px;
}

.gallery-grid figure {
  margin: 0;
  background: var(--background);
  border-radius: 12px;
  overflow: hidden;
}

.gallery-grid img {
  width: 100%;
  height: 275px;
  object-fit: cover;
  transition: transform 0.3s;
}

.gallery-grid img:hover {
  transform: scale(1.04);
}

.gallery-grid figcaption {
  padding: 12px 15px;
  font-size: 0.85rem;
  font-weight: 600;
}

/* CONTACT */
.contact-section {
  background: var(--navy);
  color: white;
}

.contact-section h2 {
  color: white;
}

.contact-section .eyebrow {
  color: #82DBD3;
}

.contact-section .btn-outline {
  color: white;
  border-color: white;
}

/* FOOTER */
.footer {
  background: #091D30;
  color: #DCE6E5;
  padding: 25px 0;
}

.footer .container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
}

.footer a {
  color: #82DBD3;
}

/* MOBILE */
@media (max-width: 900px) {
  .menu-toggle {
    display: block;
  }

  .nav-links {
    display: none;
    position: absolute;
    top: 76px;
    left: 0;
    right: 0;
    background: white;
    padding: 20px 5%;
    box-shadow: 0 12px 20px rgba(0,0,0,0.08);
    flex-direction: column;
    align-items: flex-start;
  }

  .nav-links.open {
    display: flex;
  }

  .hero-grid {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .hero-image img {
    max-width: 400px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .gallery-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .section {
    padding: 55px 0;
  }

  .hero {
    padding: 55px 0;
  }

  .card-grid,
  .gallery-grid {
    grid-template-columns: 1fr;
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer .container {
    flex-direction: column;
    text-align: center;
  }
}
